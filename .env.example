# Drill agent env. Copy to .env and fill in.
# Every model call goes through OpenRouter: one key, any lab's models.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Default: anthropic/claude-opus-5.5
LLM_MODEL=
# Where to write generated drafts. Default: ./output/drafts/<register>/
DRAFTS_DIR=
# Track which concepts have been drilled. JSON file path.
DRILL_LEDGER=./curriculum/ledger.json
# Optional notification bridge. Leave blank to skip bridge delivery.
NOTIFY=0
TELEGRAM_BRIDGE_URL=
TELEGRAM_CHAT_ID=
